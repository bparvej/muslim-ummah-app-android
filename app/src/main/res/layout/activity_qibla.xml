<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ivory"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="কিবলা কম্পাস (Qibla Compass)"
        android:textColor="@color/emerald"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="ঢাকা, বাংলাদেশ • কাবার দিক: ২৭৮° (পশ্চিম-উত্তর-পশ্চিম)"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <FrameLayout
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_marginTop="36dp"
        android:background="@drawable/ic_launcher_mosque_background">

        <ImageView
            android:id="@+id/iv_compass_dial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Compass Dial"
            android:padding="20dp"
            android:src="@drawable/ic_launcher_mosque_foreground" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_qibla_degree"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="কম্পাস ডিগ্রি: 278°"
        android:textColor="@color/emerald"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="স্মার্টফোনের সেন্সর ক্যালিব্রেট করতে ফোন ৮ আকৃতিতে ঘোরান।"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

</LinearLayout>
