<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ivory">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_detail_dua_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ঘুমানোর পূর্বের দোয়া"
            android:textColor="@color/emerald"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_detail_dua_arabic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:padding="16dp"
            android:text="بِاسْمِكَ اللَّهُمَّ أَمُوتُ وَأَحْيَا"
            android:textColor="@color/emerald"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_detail_dua_pronunciation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#11075B45"
            android:padding="12dp"
            android:text="বাংলা উচ্চারণ: বিসমিকাল্লা-হুম্মা আমূতু ওয়া আহ্ইয়া"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/tv_detail_dua_translation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:padding="16dp"
            android:text="অর্থ: হে আল্লাহ! আপনারই নামে আমি মৃত্যুবরণ (ঘুমাই) করি এবং আপনারই নামে জীবিত (জাগ্রত) হই।"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tv_detail_dua_ref"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="উৎস: সহিহ বুখারি ৬৩১২"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
