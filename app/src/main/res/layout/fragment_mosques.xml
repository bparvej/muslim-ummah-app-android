<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ivory"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_mosque_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="কাছের মসজিদ (Nearby Mosques)"
        android:textColor="@color/emerald"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_radius_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="12dp"
        android:text="১.০ কিমি ব্যাসার্ধে অনুসন্ধান করা হচ্ছে..."
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <EditText
        android:id="@+id/et_search_mosque"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:background="#FFFFFF"
        android:hint="মসজিদের নাম দিয়ে খুঁজুন..."
        android:padding="12dp"
        android:textSize="14sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_mosques"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>
